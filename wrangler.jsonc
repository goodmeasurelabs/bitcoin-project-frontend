{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gm-bitcoin-price",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/robots.txt"
    ]
  },
  "vars": {
    "NEWSLETTER_ENV": "production",
    "NEWSLETTER_SEND_ENABLED": "false",
    "MIGRATION_CRON_ENABLED": "false",
    "MIGRATION_RELAY_ENABLED": "false",
    "MIGRATION_PRODUCTION_WRITES_ENABLED": "false",
    "URL": "https://whatsbitcoinsprice.com"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "BITCOIN_DB",
      "database_name": "gm-bitcoin-data",
      "database_id": "74f8cb0b-6a5f-47fd-9152-ef725eb9f998"
    }
  ]
}
